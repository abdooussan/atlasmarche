# Copy this file to .env and fill in your values.
# Never put these database credentials inside the mobile app.

# PostgreSQL connection (same settings as your Python script)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=marches_publics

# Table with the tenders (consultations)
CONSULTATIONS_TABLE=tenders
# Table with award results. Leave empty: your database doesn't have one yet.
ATTRIBUTIONS_TABLE=

PORT=4000
# Comma-separated list of allowed web origins (mobile apps don't need CORS)
CORS_ORIGINS=http://localhost:8081
