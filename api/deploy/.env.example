# Copy to .env on the server:   cp .env.example .env && nano .env

# Public address of the API.
# No domain yet? Use your server's IP followed by .sslip.io — it gets real HTTPS:
#   API_DOMAIN=51.75.12.34.sslip.io
# With a domain later (point an "A" record to the server's IP first):
#   API_DOMAIN=api.mondomaine.ma
API_DOMAIN=CHANGE_ME.sslip.io

# Database passwords — use long random values. Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
API_DB_PASSWORD=CHANGE_ME

# Major version of PostgreSQL on your Mac (run:  psql --version  -> e.g. 17.6 -> 17)
# The server must use the same or a newer version to import your data.
POSTGRES_VERSION=17

PGDATABASE=marches_publics
CONSULTATIONS_TABLE=tenders
ATTRIBUTIONS_TABLE=

# Only needed if a website (not the mobile app) calls the API from a browser.
CORS_ORIGINS=

# Identity written in the portal's form when the app downloads a tender's documents (service "dce").
# Required: nom, prénom, email, raison sociale. Without them the "Récupérer le dossier" button
# answers "Service momentanément indisponible".
DCE_NOM=
DCE_PRENOM=
DCE_EMAIL=
DCE_RAISON_SOCIALE=
DCE_ICE=
DCE_TELEPHONE=
DCE_VILLE=
