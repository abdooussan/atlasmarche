{
  "name": "marches-files-api",
  "version": "1.0.0",
  "private": true,
  "description": "Serves the tender files saved in /opt/marches/dce/<id>. Independent from the main API.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3"
  }
}
